                },
                "pd": {
                  ".validate": "newData.isNumber()"
                },
                "brn": {
                  ".validate": "newData.isNumber()"
                },
                "par": {
                  ".validate": "newData.isNumber()"
                },
                "ca": {
                  ".validate": "newData.isNumber()"
                },
                "cs": {
                  ".validate": "newData.isNumber()"
                },
                "uid": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "tb": {
                  ".validate": "newData.hasChildren(['s', 'i'])",
                  "s": {
                    ".validate": "newData.isString() && newData.val().length <= 20"
                  },
                  "i": {
                    ".validate": "newData.isNumber()"
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "tn": {
              ".validate": "newData.isNumber()"
            },
            "rn": {
              ".validate": "newData.isNumber()"
            },
            "dm": {
              ".validate": "newData.isNumber()"
            },
            "dmas": {
              ".validate": "newData.isNumber()"
            },
            "nu": {
              ".validate": "newData.isNumber()"
            },
            "cs": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "fs": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "ss": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "ph": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "go": {
              ".validate": "newData.isBoolean()"
            },
            "sa": {
              ".validate": "newData.hasChildren(['side', 'index'])",
              "side": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "index": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "st": {
              ".validate": "newData.hasChildren(['side', 'index'])",
              "side": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "index": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "smd": {
              ".validate": "newData.hasChildren(['side', 'index'])",
              "side": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "index": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "sk": {
              ".validate": "newData.hasChildren(['label'])",
              "label": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "type": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "target": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$other": {
                ".validate": false
              }
            },
            "by": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "log": {
              ".validate": "newData.isString() && newData.val().length <= 10000"
            },
            "dice": {
              ".validate": "newData.hasChildren()",
              "side": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "actorName": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "roll": {
                ".validate": "newData.isNumber()"
              },
              "actionLabel": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "$other": {
                ".validate": false
              }
            },
            "initRoll": {
              ".validate": "newData.hasChildren()",
              "playerRoll": {
                ".validate": "newData.isNumber()"
              },
              "enemyRoll": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "rematch": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
