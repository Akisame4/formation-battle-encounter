{
  "rules": {
    ".read": false,
    ".write": false,
    "fbe": {
      "rooms": {
        ".indexOn": [
          "createdAt"
        ],
        ".read": "auth != null && query.orderByChild == 'createdAt' && query.endAt == now - (now % 3600000) - 43200000 && query.limitToFirst <= 50",
        "$roomId": {
          ".read": "auth != null",
          ".write": "auth != null && ( (!data.exists() && newData.child('hostId').val() === auth.uid) || (data.exists() && (data.child('hostId').val() === auth.uid || data.child('guestId').val() === auth.uid)) || (data.exists() && data.child('status').val() === 'waiting' && !data.child('guestId').exists() && newData.child('guestId').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('createdAt').val() < now - 43200000) )",
          ".validate": "$roomId.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['status', 'hostId', 'mode', 'createdAt'])",
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(waiting|setup|battle|finished)$/)"
          },
          "hostId": {
            ".validate": "newData.isString() && newData.val().length <= 128 && (!data.exists() || data.val() === newData.val())"
          },
          "guestId": {
            ".validate": "newData.isString() && newData.val().length <= 128 && newData.val() !== data.parent().child('hostId').val()"
          },
          "mode": {
            ".validate": "newData.isString() && newData.val().matches(/^(normal|test)$/)"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (data.exists() ? data.val() === newData.val() : newData.val() <= now + 60000 && newData.val() >= now - 60000)"
          },
          "setup": {
            "$uid": {
              ".validate": "$uid === data.parent().parent().child('hostId').val() || $uid === data.parent().parent().child('guestId').val() || $uid === newData.parent().parent().child('hostId').val() || $uid === newData.parent().parent().child('guestId').val()",
              "entries": {
                ".validate": "newData.hasChildren()",
                "$n": {
                  ".validate": "$n.matches(/^[0-9]$/) && newData.hasChildren(['id', 'position'])",
                  "id": {
                    ".validate": "newData.isString() && newData.val().length <= 40"
                  },
                  "position": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "ready": {
                ".validate": "newData.isBoolean()"
              },
              "decisiveMomentTurn": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "battle": {
            "pb": {
              "$i": {
                ".validate": "$i.matches(/^[0-8]$/) && newData.hasChildren(['tid'])",
                "tid": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "hp": {
                  ".validate": "newData.isNumber()"
                },
                "mhp": {
                  ".validate": "newData.isNumber()"
                },
                "g": {
                  ".validate": "newData.isNumber()"
                },
                "cd": {
                  ".validate": "newData.isNumber()"
                },
                "ab": {
                  ".validate": "newData.isNumber()"
                },
                "dti": {
                  ".validate": "newData.isNumber()"
                },
                "ddd": {
                  ".validate": "newData.isNumber()"
                },
                "im": {
                  ".validate": "newData.isNumber()"
                },
                "pd": {
                  ".validate": "newData.isNumber()"
                },
                "brn": {
                  ".validate": "newData.isNumber()"
                },
                "par": {
                  ".validate": "newData.isNumber()"
                },
                "ca": {
                  ".validate": "newData.isNumber()"
                },
                "cs": {
                  ".validate": "newData.isNumber()"
                },
                "uid": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "tb": {
                  ".validate": "newData.hasChildren(['s', 'i'])",
                  "s": {
                    ".validate": "newData.isString() && newData.val().length <= 20"
                  },
                  "i": {
                    ".validate": "newData.isNumber()"
                  },
                  "$other": {
                    ".validate": false
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "eb": {
              "$i": {
                ".validate": "$i.matches(/^[0-8]$/) && newData.hasChildren(['tid'])",
                "tid": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "hp": {
                  ".validate": "newData.isNumber()"
                },
                "mhp": {
                  ".validate": "newData.isNumber()"
                },
                "g": {
                  ".validate": "newData.isNumber()"
                },
                "cd": {
                  ".validate": "newData.isNumber()"
                },
                "ab": {
                  ".validate": "newData.isNumber()"
                },
                "dti": {
                  ".validate": "newData.isNumber()"
                },
                "ddd": {
                  ".validate": "newData.isNumber()"
                },
                "im": {
